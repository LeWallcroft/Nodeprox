# NodeProx production deployment template. Copy to .env.production on the VPS.
# Never commit the populated file or place its values in Dockerfiles or Compose.

# REQUIRED — database service. DATABASE_URL must use Docker service DNS, not localhost.
POSTGRES_DB=nodeprox
POSTGRES_USER=nodeprox
POSTGRES_PASSWORD=replace-with-a-long-unique-secret
DATABASE_URL=postgres://nodeprox:replace-with-a-long-unique-secret@postgres:5432/nodeprox

# REQUIRED — Redis queue/cache service. Use the Docker service DNS, not localhost.
REDIS_PASSWORD=replace-with-a-long-unique-secret
REDIS_URL=redis://:replace-with-a-long-unique-secret@redis:6379/0

# REQUIRED — API and runtime
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3001
LOG_LEVEL=info
PUBLIC_MEDIA_ORIGIN=https://media.nodeprox.org
CLOUDFLARE_ZONE_ID=replace-with-cloudflare-zone-id
CLOUDFLARE_PURGE_API_TOKEN=replace-with-cloudflare-zone-scoped-purge-token
PROCESSING_QUEUE_NAME=chapter-processing

# REQUIRED SECRET — Backblaze B2 production storage. These stay server-side.
STORAGE_PROVIDER=b2
B2_ENDPOINT=https://s3.example.backblazeb2.com
B2_REGION=us-west-000
B2_BUCKET=replace-with-production-bucket
B2_KEY_ID=replace-with-b2-key-id
B2_APPLICATION_KEY=replace-with-b2-application-key

# REQUIRED SECRET — first-admin bootstrap only when intentionally running that command.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-unique-secret

# OPTIONAL — operational hard limits. Keep values aligned with the approved product policy.
UPLOAD_MAX_SIZE_BYTES=536870912
UPLOAD_PENDING_TTL_SECONDS=86400
PROCESSING_MAX_ENTRIES=1000
PROCESSING_MAX_TOTAL_SIZE_BYTES=536870912
PROCESSING_MAX_IMAGE_SIZE_BYTES=67108864
MEDIA_WARN_IMAGE_SIZE_BYTES=8388608
MEDIA_WARN_WIDTH_PX=4000
MEDIA_WARN_HEIGHT_PX=12000

# REQUIRED SECRET — Discord bot integration. Compose injects the internal
# container URLs; do not set localhost addresses for these services.
DISCORD_APPLICATION_ID=replace-with-discord-application-id
DISCORD_BOT_TOKEN=replace-with-discord-bot-token
DISCORD_GUILD_ID=replace-with-discord-guild-id
DISCORD_CONTROL_CHANNEL_ID=replace-with-discord-control-channel-id
DISCORD_BOT_INTERNAL_TOKEN=replace-with-a-long-unique-secret

# AUTH/SESSION — the current implementation uses server-side database sessions
# and secure cookies in production; it has no standalone JWT/signing secret.
# Do not add cookies or session tokens to this file manually.

# OPTIONAL — Caddy can obtain ACME certificates without an email. Set a monitored address if desired.
# CADDY_EMAIL=ops@example.com
