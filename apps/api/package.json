{
  "name": "@nodeprox/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --outDir dist",
    "dev": "node --env-file=../../.env --import tsx/esm --watch src/server.ts",
    "start": "node dist/apps/api/src/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@fastify/multipart": "^10.1.1",
    "@nodeprox/config": "workspace:*",
    "@nodeprox/schemas": "workspace:*",
    "@nodeprox/storage": "workspace:*",
    "@nodeprox/types": "workspace:*",
    "bullmq": "^6.2.0",
    "fastify": "^5.5.0",
    "ioredis": "^6.0.0"
  }
}
