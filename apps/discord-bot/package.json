{
  "name": "@nodeprox/discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --outDir dist",
    "dev": "node --env-file=../../.env --import tsx/esm --watch src/main.ts",
    "start": "node dist/apps/discord-bot/src/main.js",
    "test": "vitest run --root ../.. apps/discord-bot/src --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.25.1",
    "pino": "^9.14.0",
    "zod": "^4.0.17"
  }
}
